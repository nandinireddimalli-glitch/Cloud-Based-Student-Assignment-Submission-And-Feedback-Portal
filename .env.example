# Copy to backend/.env
APP_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./assignment_portal.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,zip,png,jpg,jpeg
CORS_ORIGINS=http://localhost:5173
SEED_PASSWORD=Student@123

# Optional cloud database:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Optional Supabase storage mode (future cloud adapter):
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=assignment-files
